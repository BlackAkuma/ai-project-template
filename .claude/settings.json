{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash platforms/claude-code/hooks/session-digest.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash platforms/claude-code/hooks/session-writeback.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash platforms/claude-code/hooks/govern-action.sh" }
        ]
      }
    ]
  }
}
